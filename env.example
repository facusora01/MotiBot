# MotivacionalBot v2 — Configuración

# Hora de envío diario en formato HH:MM (horario de Argentina)
HORA_ENVIO=08:00

# Path de Chromium (en Ubuntu Server: /usr/bin/chromium)
CHROMIUM_PATH=/usr/bin/chromium

# ─── RE-VINCULACIÓN AUTOMÁTICA (alerta por mail + código en vivo) ──────────────
# Número del bot en formato internacional, solo dígitos (ej: 5491122334455).
# Necesario para generar el código de pairing.
BOT_PHONE=

# Token secreto para proteger la página /pair (inventá uno largo y aleatorio).
PAIR_TOKEN=

# SMTP para mandar la alerta. Ejemplo con Gmail (requiere "app password", NO tu
# clave normal): https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=tucuenta@gmail.com
SMTP_PASS=
# A dónde llega la alerta (si vacío, usa SMTP_USER)
ALERT_TO=tucuenta@gmail.com

# Números con permisos de super admin (/mbot stop, sync), separados por coma.
# Solo dígitos, formato internacional (también acepta lids de WhatsApp).
SUPER_ADMINS=5491122334455,549...

# Email para identificarse ante MyMemory (traductor). Opcional: sube la cuota
# diaria de traducción. Vacío = cuota anónima.
MYMEMORY_EMAIL=
